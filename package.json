{
  "name": "@mouseba11/quirky-bools",
  "version": "1.0.0",
  "description": "Quirky package for immutable fuzzy booleans you can pass through a project. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/qbool.test.ts",
    "prepublishOnly": "npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "publish:npm": "npm publish --access public",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com"
  },
  "keywords": [
    "boolean",
    "fuzzy-logic",
    "fuzzy",
    "qbool",
    "probability",
    "immutable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouseba11/quirky-bools.git"
  },
  "bugs": {
    "url": "https://github.com/mouseba11/quirky-bools/issues"
  },
  "homepage": "https://github.com/mouseba11/quirky-bools#readme",
  "author": "mouseba11",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
